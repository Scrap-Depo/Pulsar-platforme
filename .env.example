VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Only for isolated local tests (never enable in production).
VITE_USE_EMULATORS=false

# Vercel sets this through its buildCommand; leave firebase for local emulators.
VITE_API_TRANSPORT=firebase
# Server-only: configure in Vercel Environment Variables, never prefix with VITE_.
# FIREBASE_SERVICE_ACCOUNT_JSON=<service account JSON for the same Firebase project>
