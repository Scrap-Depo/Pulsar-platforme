{
  "name": "pulsar-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --project tsconfig.app.json --noEmit --incremental false && vite build",
    "preview": "vite preview",
    "test": "node --test tests/domain.test.mjs",
    "test:integration": "node --test tests/integration.test.mjs",
    "test:browser": "playwright test",
    "dev:emulators": "firebase emulators:start --project demo-pulsar",
    "test:load": "node tests/load-client.mjs",
    "test:first-burst": "PULSAR_LOAD_MODE=hidden PULSAR_LOAD_TYPE=multiple-choice PULSAR_LOAD_REPEATS=2 PULSAR_LOAD_ASSERT_BUDGET=true node tests/load-client.mjs",
    "dev:load-server": "node tests/serve-callable.mjs",
    "prepare:transition": "node scripts/build-transition-rules.mjs",
    "check:transition": "node scripts/build-transition-rules.mjs --check",
    "test:transition": "node --test tests/transition.test.mjs"
  },
  "dependencies": {
    "firebase": "^12.11.0",
    "lucide-react": "^0.542.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@google-cloud/functions-framework": "^5.0.5",
    "@playwright/test": "^1.63.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "firebase-tools": "^15.32.1",
    "prettier": "^3.9.9",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "cloudevents": {
      "uuid": "^11.1.1"
    }
  }
}
